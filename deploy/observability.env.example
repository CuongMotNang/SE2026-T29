# Bind dashboards to localhost by default. Use 0.0.0.0 only on a protected demo network.
OBS_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093

# Replace these before using the shared demo machine.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Path is resolved relative to deploy/compose.observability.yaml.
ALERTMANAGER_DISCORD_WEBHOOK_FILE=./observability/alertmanager/discord-webhook-url
