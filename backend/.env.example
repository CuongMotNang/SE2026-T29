BOOKING_DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:5432/booking
BOOKING_RELEASE=dev
BOOKING_COMMIT_SHA=unknown
BOOKING_DB_TIMEOUT_SECONDS=3
BOOKING_FAULT_MODE=off
BOOKING_FAULT_RATE=1.0
# BOOKING_FAULT_UNTIL=2026-10-26T15:00:00+07:00
BOOKING_FAULT_LATENCY_SECONDS=3
BOOKING_TELEMETRY_ENABLED=false
BOOKING_SERVICE_NAME=booking-api
BOOKING_DEPLOYMENT_ENVIRONMENT=local
BOOKING_OTLP_ENDPOINT=http://otel-collector:4317
BOOKING_OTLP_INSECURE=true
BOOKING_TELEMETRY_EXPORTER_TIMEOUT_MILLIS=2000
BOOKING_TELEMETRY_MAX_QUEUE_SIZE=512
BOOKING_TELEMETRY_MAX_EXPORT_BATCH_SIZE=64
BOOKING_TELEMETRY_SCHEDULE_DELAY_MILLIS=1000
BOOKING_TELEMETRY_METRIC_EXPORT_INTERVAL_MILLIS=10000
BOOKING_TELEMETRY_EXPORT_LOGS=true
